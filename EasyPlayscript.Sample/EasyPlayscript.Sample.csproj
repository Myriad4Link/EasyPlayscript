<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <RootNamespace>EasyPlayscript.Sample</RootNamespace>
        <PlayscriptAesKey>dev-key-change-me</PlayscriptAesKey>

        <!--        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>-->
    </PropertyGroup>
    <ItemGroup>
        <CompilerVisibleProperty Include="PlayscriptOutputPath"/>
        <CompilerVisibleProperty Include="PlayscriptAesKey"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="EasyPlayscript.Core" Version="0.1.1"/>
        <PackageReference Include="EasyPlayscript.Generator" Version="0.1.1" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <PackageReference Include="EasyPlayscript.BuildTask" Version="0.1.1"/>
    </ItemGroup>
    <ItemGroup>
        <ScptFiles Include="scripts\**\*.scpt"/>
        <AdditionalFiles Include="@(ScptFiles)"/>
    </ItemGroup>
</Project>
