{
  "name": "easyplayscript",
  "displayName": "EasyPlayscript",
  "description": "Language support for EasyPlayscript (.scpt) — syntax highlighting, diagnostics, and semantic tokens",
  "version": "0.1.0",
  "publisher": "myriad4link",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Myriad4Link/EasyPlayscript"
  },
  "categories": ["Programming Languages"],
  "keywords": ["playscript", "scpt", "nvl", "visual novel", "game dialog"],
  "engines": {
    "vscode": "^1.74.0"
  },
  "activationEvents": [
    "onLanguage:playscript"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "playscript",
        "aliases": ["EasyPlayscript", "playscript"],
        "extensions": [".scpt"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "playscript",
        "scopeName": "source.playscript",
        "path": "./syntaxes/playscript.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "EasyPlayscript",
      "properties": {
        "easyplayscript.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the EasyPlayscript.LSP executable. Leave empty to use the bundled server."
        },
        "easyplayscript.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces communication between VS Code and the EasyPlayscript language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.3.0"
  }
}
