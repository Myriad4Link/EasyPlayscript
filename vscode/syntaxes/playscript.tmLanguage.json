{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "EasyPlayscript",
  "scopeName": "source.playscript",
  "patterns": [
    {
      "include": "#block"
    },
    {
      "include": "#comment"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.number-sign.playscript",
      "match": "#.*$"
    },
    "block": {
      "patterns": [
        {
          "include": "#interface-block"
        },
        {
          "include": "#script-block"
        },
        {
          "include": "#text-block"
        }
      ]
    },
    "interface-block": {
      "name": "meta.interface.playscript",
      "begin": "(\\b(?:async\\s+)?interface\\b)",
      "beginCaptures": {
        "1": {
          "patterns": [
            {
              "match": "\\basync\\b",
              "name": "storage.modifier.async.playscript"
            },
            {
              "match": "\\binterface\\b",
              "name": "keyword.declaration.interface.playscript"
            }
          ]
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.end.playscript"
        }
      },
      "patterns": [
        {
          "include": "#interface-params"
        },
        {
          "include": "#types"
        },
        {
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
          "name": "entity.name.function.playscript"
        },
        {
          "include": "#comment"
        },
        {
          "match": "\\]",
          "name": "punctuation.definition.end.playscript"
        }
      ]
    },
    "interface-params": {
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.parameters.begin.playscript" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.parameters.end.playscript" }
      },
      "patterns": [
        {
          "match": ",",
          "name": "punctuation.separator.comma.playscript"
        },
        {
          "match": ":",
          "name": "punctuation.separator.colon.playscript"
        },
        {
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
          "name": "variable.parameter.playscript"
        },
        {
          "include": "#types"
        }
      ]
    },
    "script-block": {
      "name": "meta.script-block.playscript",
      "begin": "\\b(script)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.script.playscript"
        },
        "2": {
          "name": "entity.name.script.playscript"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.end.playscript"
        }
      },
      "patterns": [
        {
          "include": "#content-script"
        },
        {
          "match": "\\[",
          "name": "punctuation.definition.begin.playscript"
        }
      ]
    },
    "text-block": {
      "name": "meta.text-block.playscript",
      "begin": "\\b(text)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "keyword.declaration.text.playscript"
        },
        "2": {
          "name": "entity.name.text.playscript"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.end.playscript"
        }
      },
      "patterns": [
        {
          "include": "#content-text"
        },
        {
          "match": "\\[",
          "name": "punctuation.definition.begin.playscript"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(string|int|decimal|bool|void)\\b",
          "name": "support.type.playscript"
        }
      ]
    },
    "content-script": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "name": "keyword.operator.page-break.playscript",
          "match": "(?<=\\n|^)\\s*(/)\\s*(?=\\r?\\n|\\r?$)"
        },
        {
          "name": "keyword.operator.separator.playscript",
          "match": "\\+"
        },
        {
          "include": "#consumer-call"
        },
        {
          "include": "#escapes"
        }
      ]
    },
    "content-text": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#consumer-call"
        },
        {
          "include": "#escapes"
        }
      ]
    },
    "consumer-call": {
      "name": "meta.function-call.playscript",
      "begin": "(@)([a-zA-Z_][a-zA-Z0-9_]*)",
      "beginCaptures": {
        "1": {
          "name": "keyword.operator.at.playscript"
        },
        "2": {
          "name": "entity.name.function.playscript"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.arguments.end.playscript"
        }
      },
      "patterns": [
        {
          "include": "#consumer-args"
        }
      ]
    },
    "consumer-args": {
      "patterns": [
        {
          "match": "\\(",
          "name": "punctuation.definition.arguments.begin.playscript"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.playscript"
        },
        {
          "name": "string.quoted.double.playscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.playscript",
              "match": "\\\\[\"\\\\]"
            }
          ]
        },
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.boolean.playscript"
        },
        {
          "match": "-?\\b[0-9]+\\.[0-9]+([eE]-?[0-9]+)?\\b",
          "name": "constant.numeric.float.playscript"
        },
        {
          "match": "-?\\b[0-9]+([eE]-?[0-9]+)?\\b",
          "name": "constant.numeric.integer.playscript"
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.playscript",
          "match": "\\\\[@#/+n\\\\]"
        }
      ]
    }
  }
}
